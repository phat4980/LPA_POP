{
  "name": "lpa-pop-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Circle K BizTrade automation service for LPA POP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node --import tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "node --test",
    "smoke:login": "node --import tsx src/smoke/login.ts",
    "smoke:po-inbox": "node --import tsx src/smoke/poInbox.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.55.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
