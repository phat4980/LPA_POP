{
  "name": "lpa-pop-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Circle K BizTrade automation service for LPA POP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "start": "node --import tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "node --import tsx --test src/utils/date.test.ts",
    "smoke:login": "node --import tsx src/smoke/login.ts",
    "smoke:po-inbox": "node --import tsx src/smoke/poInbox.ts",
    "smoke:date-picker": "node --import tsx src/smoke/datePicker.ts",
    "smoke:search": "node --import tsx src/smoke/search.ts",
    "smoke:select-all": "node --import tsx src/smoke/selectAll.ts",
    "smoke:pdf-generation": "node --import tsx src/smoke/pdfGeneration.ts",
    "smoke:pdf-download": "node --import tsx src/smoke/pdfDownload.ts",
    "smoke:pagination": "node --import tsx src/smoke/pagination.ts",
    "automation:circlek-po-inbox": "node --import tsx src/runCircleKPOInbox.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.55.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
